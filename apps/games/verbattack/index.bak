<body>
    
    <audio id="audio">
        <source src="" type="audio/mpeg">
        Your browser does not support the audio element.
        
    </audio>    
 
<!-- Enter in the players names -->
<div id="container2">
    <div class="teams">
        <textarea placeholder="team 1" spellcheck="false" type="text" id="team1" class="teamboxes"></textarea>
        
        <div id="header">
            <p id="head">Left Side</p>
        </div>
        
        <div id="header">
            <p id="head2">Right Side</p>
        </div>

        <textarea placeholder="team 2"spellcheck="false" type="text" id="team2" class="teamboxes"></textarea>
    </div>
</div>

