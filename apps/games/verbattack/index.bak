    <!-- Anton Font -->
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
    
    <!--  adding in a favicon  -->
        <link rel="shortcut icon" type="image/jpg" href="../favicon.png"/>
    
    <title>Verb Attack</title>
    
